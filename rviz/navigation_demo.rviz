Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Semantic Octomap1/Known Semantic Map1
        - /FAR Graph1/Persistent Global Static Graph1
        - /FAR Graph1/Current Search Graph (Yellow)1
        - /FAR Graph1/Current Search Graph (Yellow)1/Namespaces1
        - /PointCloud21
        - /Axes2
      Splitter Ratio: 0.5199999809265137
    Tree Height: 302
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Image
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3499999940395355
      Cell Size: 1
      Class: rviz/Grid
      Color: 110; 110; 115
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: octomap_rviz_plugin/ColorOccupancyGrid
          Enabled: true
          Max. Height Display: 3
          Max. Octree Depth: 16
          Min. Height Display: -3
          Name: Known Semantic Map
          Octomap Topic: /octomap_color
          Queue Size: 3
          Value: true
          Voxel Alpha: 0.5
          Voxel Coloring: Cell Color
          Voxel Rendering: Occupied Voxels
      Enabled: true
      Name: Semantic Octomap
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Go2 Robot
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /viz_contour_topic
          Name: Current Contours
          Namespaces:
            angle_direct: true
            contour: true
            matched_vertex: true
            necessary_vertex: true
            polygon_vertex: true
            vertex_angle: true
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /viz_static_global_graph
          Name: Persistent Global Static Graph
          Namespaces:
            static_global_edges: true
            static_global_nodes: true
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /viz_static_main_graph
          Name: Searchable Static Main Component
          Namespaces:
            static_main_edges: true
            static_main_nodes: true
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /viz_current_search_graph
          Name: Current Search Graph (Yellow)
          Namespaces:
            search_graph_edges: true
            search_graph_nodes: true
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /viz_dynamic_local_graph
          Name: Current Dynamic Local Graph
          Namespaces:
            {}
          Queue Size: 20
          Value: false
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /viz_graph_topic
          Name: Current Merged Graph
          Namespaces:
            {}
          Queue Size: 20
          Value: false
      Enabled: true
      Name: FAR Graph
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /viz_node_topic
          Name: Original Goal and FAR Waypoint
          Namespaces:
            free_odom_position: true
            out_contour: true
          Queue Size: 20
          Value: true
        - Alpha: 1
          Class: rviz/PointStamped
          Color: 255; 60; 255
          Enabled: true
          History Length: 1
          Name: Current Waypoint
          Queue Size: 10
          Radius: 0.3499999940395355
          Topic: /way_point
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /viz_path_topic
          Name: FAR Global Path
          Namespaces:
            {}
          Queue Size: 20
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 40; 220; 255
          Enabled: true
          Head Diameter: 0.25
          Head Length: 0.20000000298023224
          Length: 0.25
          Line Style: Billboards
          Line Width: 0.07999999821186066
          Name: Local Planner Path
          Offset:
            X: 0
            Y: 0
            Z: 0.03999999910593033
          Pose Color: 40; 220; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.07999999821186066
          Shaft Length: 0.10000000149011612
          Topic: /path
          Unreliable: false
          Value: true
      Enabled: true
      Name: Goals and Paths
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 0; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 0; 255
          Min Color: 255; 0; 255
          Name: Live Dynamic Cloud
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: true
          Size (Pixels): 6
          Size (m): 0.18000000715255737
          Style: Spheres
          Topic: /FAR_dynamic_obs_debug
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /viz_dynamic_blocked_edges
          Name: Dynamic-Blocked Search Edges
          Namespaces:
            {}
          Queue Size: 20
          Value: true
      Enabled: false
      Name: Dynamic Obstacles
    - Alpha: 1
      Class: rviz/Axes
      Enabled: false
      Length: 1
      Name: Axes
      Radius: 0.10000000149011612
      Reference Frame: <Fixed Frame>
      Show Trail: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: traversability
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05000000074505806
      Style: Flat Squares
      Topic: /local_3d_semantic_voxel_map/global_semantic_admission_grid
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /esam3/overlay
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: Axes
      Radius: 0.10000000149011612
      Reference Frame: wuba_base
      Show Trail: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 238; 238; 236
    Default Light: true
    Fixed Frame: map_start
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 71.50482177734375
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398006439209
      Focal Point:
        X: 19.980504989624023
        Y: 19.834209442138672
        Z: 2.332498788833618
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.2649999856948853
      Target Frame: map_start
      Yaw: 2.7749836444854736
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1376
  Hide Left Dock: false
  Hide Right Dock: true
  Image:
    collapsed: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 2488
  X: 72
  Y: 27
