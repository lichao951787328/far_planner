Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Semantic Octomap1
        - /FAR Graph1
        - /Goals and Paths1
        - /Dynamic Obstacles1
      Splitter Ratio: 0.5199999809265137
