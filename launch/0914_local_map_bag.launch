<launch>
  <!--
    Offline local-map replay for the 2026-09-14 dataset.

    Recorded topics used by this launch:
      /grids_points         sensor_msgs/PointCloud2
      /livox/lidar          livox_ros_driver2/CustomMsg
      /fusion_localization  nav_msgs/Odometry
      /tf                   tf2_msgs/TFMessage

    far_scan_input_adapter accepts the recorded Livox CustomMsg directly,
    deskews it with acquisition-time TF, and emits registered PointCloud2.
  -->
  <arg name="bag"
       default="$(env HOME)/social_nav/src/mapless_navigation_old/src/dateset/0914/2026-09-14-13-47-53.bag"/>
  <arg name="play_bag" default="true"/>
  <arg name="start_paused" default="false"/>
  <arg name="rate" default="1.0"/>
  <arg name="delay" default="2.0"/>
  <arg name="rviz" default="true"/>

  <arg name="grids_points_topic" default="/grids_points"/>
  <arg name="raw_lidar_topic" default="/livox/lidar"/>
  <arg name="start_scan_adapter" default="true"/>
  <arg name="registered_scan_topic"
       default="/far_scan/registered_scan"/>
  <arg name="registered_scan_origin_topic"
       default="/far_scan/registered_scan_origin"/>
  <arg name="global_frame" default="map"/>
  <arg name="reference_frame" default="map_start"/>
  <arg name="vehicle_frame" default="wuba_base"/>
  <arg name="ssmi_topic" default="/semantic_pcl/global_admitted"/>
  <arg name="enable_two_layer_angular_clearing" default="false"/>
  <arg name="semantic_schema"
       default="$(find far_planner)/config/five_class_semantic_schema.yaml"/>
  <arg name="local_voxel_config"
       default="$(find far_planner)/config/five_class_local_voxel.yaml"/>

  <!-- All node timers and TF lookups follow the timestamps recorded in bag. -->
  <param name="/use_sim_time" value="true"/>
  <!-- Local3D derives its classes and costs from the same schema as the grid
       adapter and SemanticOctomap. Load it before any consumer starts. -->
  <rosparam command="load" file="$(arg semantic_schema)"/>

  <include file="$(find local3d_semantic_voxel_map)/launch/grids_points_voxel_map.launch">
    <arg name="config" value="$(arg local_voxel_config)"/>
    <arg name="input_topic" value="$(arg grids_points_topic)"/>
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="use_initial_pose_reference" value="true"/>
    <arg name="reference_frame" value="$(arg reference_frame)"/>
    <arg name="local_cost_frame" value="$(arg vehicle_frame)"/>
    <arg name="ssmi_topic" value="$(arg ssmi_topic)"/>
    <arg name="enable_two_layer_angular_clearing"
         value="$(arg enable_two_layer_angular_clearing)"/>
    <arg name="rviz_frame" value="$(arg reference_frame)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>

  <group if="$(arg start_scan_adapter)">
    <include file="$(find far_planner)/launch/scan_input_adapter.launch">
      <arg name="input_topic" value="$(arg raw_lidar_topic)"/>
      <arg name="output_topic" value="$(arg registered_scan_topic)"/>
      <arg name="origin_topic" value="$(arg registered_scan_origin_topic)"/>
      <arg name="world_frame" value="$(arg global_frame)"/>
      <arg name="vehicle_frame" value="$(arg vehicle_frame)"/>
      <arg name="lidar_frame" value="livox_frame"/>
    </include>
  </group>

  <!-- Two nodes make start_paused selectable without shell command syntax. -->
  <group if="$(arg play_bag)">
    <node unless="$(arg start_paused)"
          pkg="rosbag" type="play" name="play_0914_local_map_bag"
          args="--clock --delay=$(arg delay) --rate=$(arg rate) $(arg bag)"
          output="screen" required="true">
      <remap from="/grids_points" to="$(arg grids_points_topic)"/>
      <remap from="/livox/lidar" to="$(arg raw_lidar_topic)"/>
    </node>

    <node if="$(arg start_paused)"
          pkg="rosbag" type="play" name="play_0914_local_map_bag_paused"
          args="--clock --pause --delay=$(arg delay) --rate=$(arg rate) $(arg bag)"
          output="screen" required="true">
      <remap from="/grids_points" to="$(arg grids_points_topic)"/>
      <remap from="/livox/lidar" to="$(arg raw_lidar_topic)"/>
    </node>
  </group>
</launch>
