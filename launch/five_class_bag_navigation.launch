<?xml version="1.0"?>
<launch>
  <!-- One-command five-class bag pipeline:
       bag -> local semantic voxel map -> FAR Planner
       -> localPlanner -> /path -> optional pathFollower. The follower emits
       only a generic Twist; no Go2 command adapter is started here. -->
  <arg name="bag"
       default="/home/yanaibo/mapless_navigation/dataset/2026-08-22-09-33-02.bag"/>
  <!-- One shared class table drives the local voxel map and FAR. -->
  <arg name="semanticSchema"
       default="$(find far_planner)/config/five_class_semantic_schema.yaml"/>
  <!-- Start at the selected stable scene time. The first cloud at this offset
       predates the first retained TF sample by 0.20 s and is dropped; the next
       cloud has an exact TF and defines map_start. -->
  <arg name="bagStart" default="20"/>
  <!-- Waiting for every advertised topic to have a subscriber guarantees that
       the reference pose is captured from the bag's first grid frame. -->
<!-- wait-for-subscribers 要求 rosbag 准备播放的每一个 bag 话题都至少有一个订阅者，才开始播放 -->
  <arg name="bagPlayArgs"
       default="--clock --delay=1"/>
  <arg name="rviz" default="true"/>
  <arg name="rvizConfig" default="navigation_demo"/>
  <arg name="startLocalPlanner" default="true"/>
  <arg name="startPathFollower" default="false"/>
  <arg name="localPathTopic" default="/path"/>
  <arg name="cmdVelTopic" default="/far_cmd_vel"/>
  <arg name="enableLegacyRaycastClearing" default="false"/>
  <arg name="enableTwoLayerAngularClearing" default="false"/>
  <arg name="enableGoalAdjustment" default="true"/>

  <param name="/use_sim_time" value="true"/>
  <rosparam command="load" file="$(arg semanticSchema)"/>

  <include file="$(find local3d_semantic_voxel_map)/launch/grids_points_voxel_map.launch">
    <arg name="config"
         value="$(find far_planner)/config/five_class_local_voxel.yaml"/>
    <arg name="input_topic" value="/grids_points"/>
    <arg name="global_frame" value="map"/>
    <arg name="use_initial_pose_reference" value="true"/>
    <arg name="reference_frame" value="map_start"/>
    <arg name="local_cost_frame" value="wuba_base"/>
    <arg name="ssmi_topic" value="/semantic_pcl/five_class_global_admitted"/>
    <arg name="enable_two_layer_angular_clearing"
         value="$(arg enableTwoLayerAngularClearing)"/>
    <arg name="rviz" value="false"/>
  </include>

  <!-- use_local_voxel_map makes the voxel snapshot the sole geometry source;
       FAR retains historical navigation topology but does not fuse the
       SemanticOctree into local contours or edge checks. -->
  <node pkg="far_planner" type="far_planner" name="far_planner"
        output="screen" required="true">
    <rosparam command="load" file="$(find far_planner)/config/default.yaml"/>
    <rosparam command="load"
              file="$(find far_planner)/config/five_class_bag.yaml"/>
    <param name="world_frame" value="map_start"/>
    <param name="local_voxel_topic"
           value="/local_3d_semantic_voxel_map/voxel_cloud"/>
    <param name="local_voxel_timeout" value="1.0"/>
    <param name="GPlanner/enable_goal_adjustment"
           value="$(arg enableGoalAdjustment)"/>
    <remap from="odom_world" to="/fusion_localization"/>
    <remap from="goal_point" to="/goal_point"/>
  </node>

  <!-- The bag already publishes /fusion_localization, so no pose-to-odometry
       adapter is started. Only convert RViz's PoseStamped goal for FAR. -->
  <node pkg="far_planner" type="pose_stamped_to_point_stamped"
        name="five_class_goal_adapter" output="screen" required="true">
    <param name="input_goal_topic" value="/move_base_simple/goal"/>
    <param name="output_goal_topic" value="/goal_point"/>
    <param name="default_frame" value="map_start"/>
  </node>

  <!-- The voxel-map cost cloud and recorded odometry are expressed in map,
       while FAR plans in map_start. Transform only the small PointStamped
       waypoint so localPlanner can keep its three global inputs in map without
       transforming the large cost cloud on every update. -->
  <group if="$(arg startLocalPlanner)">
    <node pkg="far_planner" type="point_stamped_tf_adapter"
          name="five_class_waypoint_map_adapter" output="screen"
          required="true">
      <param name="input_topic" value="/way_point"/>
      <param name="output_topic" value="/way_point_map"/>
      <param name="target_frame" value="map"/>
      <param name="transform_timeout" value="0.2"/>
    </node>

    <include file="$(find local_planner)/launch/local_planner.launch">
      <arg name="startLocalPlanner" value="true"/>
      <arg name="startPathFollower" value="$(arg startPathFollower)"/>
      <arg name="worldFrameId" value="map"/>
      <arg name="odometryTopic" value="/fusion_localization"/>
      <arg name="staticObstacleTopic"
           value="/local_3d_semantic_voxel_map/traversability_cost_cloud"/>
      <arg name="useAddedObstacles" value="false"/>
      <arg name="requireDynamicObstacleCloud" value="false"/>
      <arg name="requireNonEmptyCostCloud" value="true"/>
      <arg name="waypointTopic" value="/way_point_map"/>
      <!-- Disabled because this bag's record-time /clock and sensor header
           stamps use different epochs. Input wall-time watchdogs remain on. -->
      <arg name="goalTimeout" value="0.0"/>
      <arg name="pathTopic" value="$(arg localPathTopic)"/>
      <arg name="cmdVelTopic" value="$(arg cmdVelTopic)"/>
      <arg name="sensorFrameId" value="wuba_base"/>
      <arg name="vehicleFrameId" value="wuba_base"/>
      <arg name="maxSpeed" value="0.3"/>
      <arg name="autonomySpeed" value="0.3"/>
    </include>
  </group>

  <!-- navigation_demo.rviz is shared with the world-frame simulator. Override
       its fixed frame for this map_start bag without changing that profile. -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz"
        name="five_class_navigation_rviz" output="screen"
        args="-d $(find far_planner)/rviz/$(arg rvizConfig).rviz -f map_start"/>

  <!-- A required player makes Ctrl-C and normal end-of-bag shut down the
       complete pipeline instead of leaving latched maps running. -->
  <node pkg="rosbag" type="play" name="five_class_bag_player"
        args="$(arg bagPlayArgs) --start=$(arg bagStart) $(arg bag)"
        output="screen" required="true">
    <!-- map_start is mission-local and must be rebuilt by the local semantic
         voxel node on every launch. Keep the recorded /tf_static, including
         its old map -> map_start, out of the active TF tree. -->
    <remap from="/tf_static" to="/recorded_tf_static"/>
  </node>
</launch>
